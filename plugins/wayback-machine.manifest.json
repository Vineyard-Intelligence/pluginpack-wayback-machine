{
  "identifier": "run.vineyard.pluginpacks.wayback_machine",
  "content_type": "vineyard:pluginpack",
  "name": "Wayback Machine",
  "version": "1.2.2",
  "description": "Queries the Internet Archive Wayback Machine for the capture history and archive availability of selected domains and URLs. Desktop only.",
  "author": {
    "name": "VINEYARD",
    "url": "https://vineyard.run"
  },
  "license": "Apache-2.0",
  "icon": "history",
  "platforms": {
    "primary": "desktop",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    },
    "desktop": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs",
      "min_app_version": "0.1.0"
    }
  },
  "distribution": {
    "kind": "git",
    "repository": "https://github.com/Vineyard-Intelligence/pluginpack-wayback-machine",
    "ref": "v1.2.0",
    "path": "plugins/wayback-machine.manifest.json"
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.wayback_snapshot_history",
      "content_type": "vineyard:plugin",
      "name": "Wayback Snapshot History",
      "version": "1.2.2",
      "description": "Lists Wayback Machine captures of each selected Domain or URL and creates one URL node per capture (replay URL, original URL, HTTP status, timestamp, digest) linked \"has archive\" from the seed. Up to limit captures per node (default 50, max 500), filtered by the from/to and drop_duplicates params. Desktop only.",
      "icon": "history",
      "platforms": {
        "primary": "desktop",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "domain"
          },
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "web",
            "name": "url"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "web",
            "name": "url"
          }
        ]
      },
      "params": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "description": "Earliest capture date, YYYYMMDD. Empty = no lower bound."
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "description": "Latest capture date, YYYYMMDD. Empty = no upper bound."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50,
            "description": "Maximum captures to fetch per node, 1–500. Default 50."
          },
          "drop_duplicates": {
            "type": "boolean",
            "default": true,
            "description": "Keep only the newest capture of each content digest. On by default."
          }
        }
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "web_probe": {
          "purpose": "Fetch the Wayback Machine capture history of each selected domain or URL."
        }
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.wayback_available",
      "content_type": "vineyard:plugin",
      "name": "Wayback Availability",
      "version": "1.2.2",
      "description": "Checks whether the Wayback Machine has a capture of each selected Domain or URL and writes the result on the node: wayback_available, plus wayback_snapshot_url, wayback_snapshot_timestamp and wayback_snapshot_status of the closest capture. Creates no nodes. Desktop only.",
      "icon": "circle-check",
      "platforms": {
        "primary": "desktop",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "infrastructure",
            "name": "domain"
          },
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "web",
            "name": "url"
          }
        ],
        "produces": []
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:update"
        ],
        "web_probe": {
          "purpose": "Check whether the Wayback Machine has a capture of each selected domain or URL."
        }
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
